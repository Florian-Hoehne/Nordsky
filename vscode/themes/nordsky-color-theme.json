    "terminal.ansiRed": "#FF7B8A",
    "terminal.ansiGreen": "#7EDC8A",
    "terminal.ansiYellow": "#F5A742",
    "terminal.ansiBlue": "#4DA3FF",
    "terminal.ansiMagenta": "#B3A5F5",
    "terminal.ansiCyan": "#4FD6BE",
    "terminal.ansiWhite": "#DCE7F2",
    "terminal.ansiBrightBlack": "#7F9BB8",
    "terminal.ansiBrightRed": "#FF9CA8",
    "terminal.ansiBrightGreen": "#B5EBC0",
    "terminal.ansiBrightYellow": "#FFD98A",
    "terminal.ansiBrightBlue": "#9CCBFF",
    "terminal.ansiBrightMagenta": "#CFC6FA",
    "terminal.ansiBrightCyan": "#9FE8D5",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5E86AE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#5FA595",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "keyword.other.documentation",
        "storage.type.class.jsdoc",
        "entity.name.tag.javadoc"
      ],
      "settings": {
        "foreground": "#4FD6BE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "variable.language",
        "constant.language"
      ],
      "settings": {
        "foreground": "#4DA3FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#9CCBFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#7EDC8A"
      }
    },
    {
      "name": "Unquoted values",
      "scope": [
        "string.unquoted",
        "string.unquoted.plain.out.yaml",
        "string.unquoted.plain.in.yaml"
      ],
      "settings": {
        "foreground": "#B5EBC0"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#F5A742"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FF7B8A"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F5A742"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.java",
        "storage.type.object.array.java",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#4FD6BE",
        "fontStyle": ""
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "storage.type.generic",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#9FE8D5"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFD98A"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.function-call",
        "entity.name.function.member.call"
      ],
      "settings": {
        "foreground": "#DCE7F2"
      }
    },
    {
      "name": "Fields",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#9CCBFF"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "storage.type.annotation",
        "meta.annotation punctuation.definition.annotation",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#B3A5F5"
      }
    },
    {
      "name": "Markup tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#9FE8D5"
      }
    },
    {
      "name": "Markup tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7F9BB8"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9CCBFF"
      }
    },
    {
      "name": "Keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name",
        "support.type.property-name.json",
        "keyword.other.definition.ini",
        "meta.property-name",
        "support.type.property-name.toml"
      ],
      "settings": {
        "foreground": "#F5A742",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7F9BB8"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#4DA3FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F5A742",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFD98A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5E86AE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4FD6BE",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Lists",
      "scope": [
        "punctuation.definition.list.begin",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#F5A742"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7EDC8A"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF7B8A"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#4DA3FF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5C6C"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#4FD6BE",
    "interface": {
      "foreground": "#4FD6BE",
      "italic": true
    },
    "enum": "#4FD6BE",
    "struct": "#4FD6BE",
    "type": "#4FD6BE",
    "typeParameter": "#9FE8D5",
    "namespace": "#DCE7F2",
    "function.declaration": "#FFD98A",
    "method.declaration": "#FFD98A",
    "property": "#9CCBFF",
    "enumMember": "#F5A742",
    "variable.readonly": "#F5A742",
    "property.readonly": "#F5A742",
    "property.static.readonly": "#F5A742",
    "annotation": "#B3A5F5",
    "decorator": "#B3A5F5",
    "macro": "#B3A5F5",
    "parameter": "#DCE7F2",
    "variable": "#DCE7F2"
  }
}
