{
  "name": "nordsky-theme",
  "displayName": "Nordsky Theme",
  "description": "Deep-navy dark themes: Nordsky (green strings, orange keys) and Nordsky Console (terminal look).",
  "version": "1.0.0",
  "publisher": "nordsky",
  "repository": {
    "type": "git",
    "url": "https://github.com/florian-hoehne/nordsky"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Nordsky",
        "uiTheme": "vs-dark",
        "path": "./themes/nordsky-color-theme.json"
      },
      {
        "label": "Nordsky Console",
        "uiTheme": "vs-dark",
        "path": "./themes/nordsky-console-color-theme.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
